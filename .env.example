# HYEHOST runtime
PORT=8080

# Optional stable identity overrides.
# Leave unset to generate and persist values automatically.
# UUID=
# WS_PATH=
# SUB_TOKEN=
# NODE_ID=
NODE_NAME=HYEHOST-01

# Railway registry
REGISTRY_URL=https://subscription-server-v2-production.up.railway.app
# Recommended for full app-push traffic tracking:
# REGISTRY_TOKEN=

# Usually leave unset. Use only if HYEHOST NAT host:port cannot be learned
# from the first public request.
# PUBLIC_ENDPOINT=http://PUBLIC_IPV4:EXTERNAL_NAT_PORT

HEARTBEAT_MS=600000
GEO_RETRY_MS=300000
TRAFFIC_RETENTION_DAYS=90
